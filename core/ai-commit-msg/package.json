{
  "name": "@stephansama/ai-commit-msg",
  "version": "1.1.0",
  "description": "generate commit messages using ai",
  "keywords": [
    "ai-commit-msg",
    "tanstack-intent"
  ],
  "homepage": "https://packages.stephansama.info/api/@stephansama/ai-commit-msg",
  "bugs": {
    "url": "https://github.com/stephansama/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephansama/packages.git",
    "directory": "core/ai-commit-msg"
  },
  "license": "MIT",
  "author": {
    "name": "Stephan Randle",
    "email": "stephanrandle.dev@gmail.com",
    "url": "https://stephansama.info"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json",
    "./schema": "./dist/schema.mjs",
    "./schema.json": "./config/schema.json"
  },
  "types": "./config/schema.d.cts",
  "bin": {
    "ai-commit-msg": "./dist/cli.mjs"
  },
  "files": [
    "./dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "build:snapshot": "tsdown -u",
    "dev": "tsdown --watch",
    "lint": "eslint ./src/ --pass-on-no-patterns --no-error-on-unmatched-pattern",
    "lint:fix": "eslint ./src/ --pass-on-no-patterns --no-error-on-unmatched-pattern --fix"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:commitlint",
    "@dotenvx/dotenvx": "catalog:",
    "@tanstack/ai": "catalog:ai",
    "@tanstack/ai-gemini": "catalog:ai",
    "@tanstack/ai-ollama": "catalog:ai",
    "@tanstack/ai-openai": "catalog:ai",
    "cosmiconfig": "catalog:cli",
    "es-toolkit": "catalog:",
    "neverthrow": "catalog:",
    "obug": "catalog:cli",
    "yargs": "catalog:cli",
    "zod": "catalog:schema"
  },
  "devDependencies": {
    "@tanstack/intent": "catalog:tanstack",
    "@types/yargs": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
