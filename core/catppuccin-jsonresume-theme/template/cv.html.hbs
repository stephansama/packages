<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>
			{{basics.name}}{{#if basics.label}} &ndash; {{basics.label}}{{/if}}
		</title>
		{{#if basics.image}}
		<link rel="icon" type="image/png" href="{{basics.image}}" />
		{{/if}}
		<style>
			{{{style}}}
		</style>
	</head>
	<body>
		<div class="cv-container">
			{{#if basics}}
			<header
				class="cv-hero"
				data-print-contact="{{#if basics.email}}{{basics.email}}{{/if}}{{#if basics.phone}}  ·  {{basics.phone}}{{/if}}{{#if basics.url}}  ·  {{basics.url}}{{else}}{{#if basics.website}}  ·  {{basics.website}}{{/if}}{{/if}}{{#if basics.location.city}}  ·  {{basics.location.city}}{{#if basics.location.region}}, {{basics.location.region}}{{/if}}{{/if}}"
			>
				<div class="cv-avatar" aria-label="{{basics.name}}">
					{{#if basics.image}}
					<img src="{{basics.image}}" alt="{{basics.name}}" />
					{{else}} {{initial basics.name}} {{/if}}
				</div>
				<h1 class="cv-name">{{basics.name}}</h1>
				{{#if basics.label}}
				<p class="cv-label">{{basics.label}}</p>
				{{/if}} {{#if basics.summary}}
				<p class="cv-summary">{{basics.summary}}</p>
				{{/if}}

				<nav class="cv-socials no-print" aria-label="Contact">
					{{#if basics.email}}
					<a
						class="cv-social is-mail"
						href="mailto:{{basics.email}}"
						aria-label="Email"
						data-tooltip="Email"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect x="3" y="5" width="18" height="14" rx="2" />
							<path d="m3 7 9 6 9-6" />
						</svg>
					</a>
					{{/if}} {{#if basics.phone}}
					<a
						class="cv-social is-phone"
						href="tel:{{basics.phone}}"
						aria-label="Phone"
						data-tooltip="Phone"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"
							/>
						</svg>
					</a>
					{{/if}} {{#if (or basics.url basics.website)}}
					<a
						class="cv-social is-site"
						href="{{#if basics.url}}{{basics.url}}{{else}}{{basics.website}}{{/if}}"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Website"
						data-tooltip="Website"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="9" />
							<path
								d="M3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"
							/>
						</svg>
					</a>
					{{/if}} {{#if basics.profiles}} {{#each basics.profiles}}
					{{#if (eq network "GitHub")}}
					<a
						class="cv-social is-github"
						href="{{url}}"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
						data-tooltip="GitHub"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
							/>
						</svg>
					</a>
					{{/if}} {{#if (eq network "Bluesky")}}
					<a
						class="cv-social is-bluesky"
						href="{{url}}"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Bluesky"
						data-tooltip="Bluesky"
					>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037c-.856 3.061-3.978 3.842-6.755 3.37c4.854.826 6.089 3.562 3.422 6.299c-5.065 5.196-7.28-1.304-7.847-2.97c-.104-.305-.152-.448-.153-.327c0-.121-.05.022-.153.327c-.568 1.666-2.782 8.166-7.847 2.97c-2.667-2.737-1.432-5.473 3.422-6.3c-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"
							/>
						</svg>
					</a>
					{{/if}} {{#if (eq network "Leetcode")}}
					<a
						class="cv-social is-leetcode"
						href="{{url}}"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Leetcode"
						data-tooltip="Leetcode"
					>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M13.483 0a1.37 1.37 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.3 5.3 0 0 0-1.209 2.104a5 5 0 0 0-.125.513a5.5 5.5 0 0 0 .062 2.362a6 6 0 0 0 .349 1.017a5.9 5.9 0 0 0 1.271 1.818l4.277 4.193l.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.38 1.38 0 0 0-1.951-.003l-2.396 2.392a3.02 3.02 0 0 1-4.205.038l-.02-.019l-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.7 2.7 0 0 1 .066-.523a2.55 2.55 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0m-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382a1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382a1.38 1.38 0 0 0-1.38-1.382z"
							/>
						</svg>
					</a>
					{{/if}} {{#if (eq network "LinkedIn")}}
					<a
						class="cv-social is-linkedin"
						href="{{url}}"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						data-tooltip="LinkedIn"
					>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037c-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85c3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.06 2.06 0 0 1-2.063-2.065a2.064 2.064 0 1 1 2.063 2.065m1.782 13.019H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"
							/>
						</svg>
					</a>
					{{/if}} {{#if (eq network "YouTube")}}
					<a
						class="cv-social is-youtube"
						href="{{url}}"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="YouTube"
						data-tooltip="YouTube"
					>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M23.498 6.186a3.02 3.02 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.02 3.02 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.02 3.02 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.02 3.02 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814M9.545 15.568V8.432L15.818 12z"
							/>
						</svg>
					</a>
					{{/if}} {{/each}} {{/if}}
				</nav>
			</header>
			{{/if}} {{#if skills}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="skills"
				aria-labelledby="skills-title"
			>
				<h2 class="section-title" id="skills-title">skills</h2>
				<div class="row-list">
					{{#each skills}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span>{{name}}</span>
							</div>
						</div>
						{{#if keywords}}
						<div class="row-body">
							<div class="tag-cluster">
								{{#each keywords}}
								<span class="tag">{{this}}</span>
								{{/each}}
							</div>
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if work}}
			<div class="squiggle" aria-hidden="true"></div>
			<section class="cv-section" id="work" aria-labelledby="work-title">
				<h2 class="section-title" id="work-title">work</h2>
				<div class="row-list">
					{{#each work}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span>{{position}}</span>
								{{#if name}}
								<span class="row-title-org"
									>{{#if url}}<a
										class="row-link"
										href="{{url}}"
										target="_blank"
										rel="noopener noreferrer"
										>{{name}}</a
									>{{else}}{{name}}{{/if}}{{#if location}} ·
									{{location}}{{/if}}</span
								>
								{{/if}}
							</div>
							{{#if startDate}}
							<span class="row-date"
								>{{formatDate startDate}}{{#if endDate}} —
								{{formatDate endDate}}{{else}} —
								Present{{/if}}</span
							>
							{{/if}}
						</div>
						{{#if (or summary highlights)}}
						<div class="row-body">
							{{#if summary}}
							<p>{{summary}}</p>
							{{/if}} {{#if highlights}}
							<ul>
								{{#each highlights}}
								<li>{{this}}</li>
								{{/each}}
							</ul>
							{{/if}}
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if education}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="education"
				aria-labelledby="education-title"
			>
				<h2 class="section-title" id="education-title">education</h2>
				<div class="row-list">
					{{#each education}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span
									>{{studyType}}{{#if area}} in
									{{area}}{{/if}}</span
								>
								{{#if institution}}
								<span class="row-title-org"
									>{{#if url}}<a
										class="row-link"
										href="{{url}}"
										target="_blank"
										rel="noopener noreferrer"
										>{{institution}}</a
									>{{else}}{{institution}}{{/if}}</span
								>
								{{/if}}
							</div>
							{{#if startDate}}
							<span class="row-date"
								>{{formatDate startDate}}{{#if endDate}} —
								{{formatDate endDate}}{{/if}}</span
							>
							{{/if}}
						</div>
						{{#if (or gpa score courses)}}
						<div class="row-body">
							{{#if (or gpa score)}}
							<p>
								GPA: {{#if gpa}}{{gpa}}{{else}}{{score}}{{/if}}
							</p>
							{{/if}} {{#if courses}}
							<div class="tag-cluster">
								{{#each courses}}
								<span class="tag">{{this}}</span>
								{{/each}}
							</div>
							{{/if}}
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if projects}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="projects"
				aria-labelledby="projects-title"
			>
				<h2 class="section-title" id="projects-title">projects</h2>
				<div class="row-list">
					{{#each projects}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span
									>{{#if url}}<a
										class="row-link"
										href="{{url}}"
										target="_blank"
										rel="noopener noreferrer"
										>{{name}}</a
									>{{else}}{{name}}{{/if}}</span
								>
								{{#if type}}
								<span class="row-title-org">{{type}}</span>
								{{/if}}
							</div>
							{{#if startDate}}
							<span class="row-date"
								>{{formatDate startDate}}{{#if endDate}} —
								{{formatDate endDate}}{{/if}}</span
							>
							{{/if}}
						</div>
						{{#if (or description highlights keywords)}}
						<div class="row-body">
							{{#if description}}
							<p>{{description}}</p>
							{{/if}} {{#if highlights}}
							<ul>
								{{#each highlights}}
								<li>{{this}}</li>
								{{/each}}
							</ul>
							{{/if}} {{#if keywords}}
							<div class="tag-cluster">
								{{#each keywords}}
								<span class="tag">{{this}}</span>
								{{/each}}
							</div>
							{{/if}}
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if publications}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="publications"
				aria-labelledby="publications-title"
			>
				<h2 class="section-title" id="publications-title">writing</h2>
				<div class="row-list">
					{{#each publications}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span
									>{{#if url}}<a
										class="row-link"
										href="{{url}}"
										target="_blank"
										rel="noopener noreferrer"
										>{{name}}</a
									>{{else}}{{name}}{{/if}}</span
								>
								{{#if publisher}}
								<span class="row-title-org">{{publisher}}</span>
								{{/if}}
							</div>
							{{#if releaseDate}}
							<span class="row-date"
								>{{formatDate releaseDate}}</span
							>
							{{/if}}
						</div>
						{{#if summary}}
						<div class="row-body">
							<p>{{summary}}</p>
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if awards}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="awards"
				aria-labelledby="awards-title"
			>
				<h2 class="section-title" id="awards-title">awards</h2>
				<div class="row-list">
					{{#each awards}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span>{{title}}</span>
								{{#if awarder}}
								<span class="row-title-org">{{awarder}}</span>
								{{/if}}
							</div>
							{{#if date}}
							<span class="row-date">{{formatDate date}}</span>
							{{/if}}
						</div>
						{{#if summary}}
						<div class="row-body">
							<p>{{summary}}</p>
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if certificates}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="certificates"
				aria-labelledby="certificates-title"
			>
				<h2 class="section-title" id="certificates-title">
					certificates
				</h2>
				<div class="row-list">
					{{#each certificates}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span
									>{{#if url}}<a
										class="row-link"
										href="{{url}}"
										target="_blank"
										rel="noopener noreferrer"
										>{{name}}</a
									>{{else}}{{name}}{{/if}}</span
								>
								{{#if issuer}}
								<span class="row-title-org">{{issuer}}</span>
								{{/if}}
							</div>
							{{#if date}}
							<span class="row-date">{{formatDate date}}</span>
							{{/if}}
						</div>
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if volunteer}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="volunteer"
				aria-labelledby="volunteer-title"
			>
				<h2 class="section-title" id="volunteer-title">volunteer</h2>
				<div class="row-list">
					{{#each volunteer}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span>{{position}}</span>
								{{#if organization}}
								<span class="row-title-org"
									>{{#if url}}<a
										class="row-link"
										href="{{url}}"
										target="_blank"
										rel="noopener noreferrer"
										>{{organization}}</a
									>{{else}}{{organization}}{{/if}}</span
								>
								{{/if}}
							</div>
							{{#if startDate}}
							<span class="row-date"
								>{{formatDate startDate}}{{#if endDate}} —
								{{formatDate endDate}}{{/if}}</span
							>
							{{/if}}
						</div>
						{{#if (or summary highlights)}}
						<div class="row-body">
							{{#if summary}}
							<p>{{summary}}</p>
							{{/if}} {{#if highlights}}
							<ul>
								{{#each highlights}}
								<li>{{this}}</li>
								{{/each}}
							</ul>
							{{/if}}
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if languages}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="languages"
				aria-labelledby="languages-title"
			>
				<h2 class="section-title" id="languages-title">languages</h2>
				<div class="row-list">
					{{#each languages}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span>{{language}}</span>
							</div>
							{{#if fluency}}
							<span class="row-date">{{fluency}}</span>
							{{/if}}
						</div>
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if interests}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="interests"
				aria-labelledby="interests-title"
			>
				<h2 class="section-title" id="interests-title">interests</h2>
				<div class="row-list">
					{{#each interests}}
					<div>
						<div class="row">
							<span class="row-glyph" aria-hidden="true">◈</span>
							<div class="row-title">
								<span>{{name}}</span>
							</div>
						</div>
						{{#if keywords}}
						<div class="row-body">
							<div class="tag-cluster">
								{{#each keywords}}
								<span class="tag">{{this}}</span>
								{{/each}}
							</div>
						</div>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
			{{/if}} {{#if references}}
			<div class="squiggle" aria-hidden="true"></div>
			<section
				class="cv-section"
				id="references"
				aria-labelledby="references-title"
			>
				<h2 class="section-title" id="references-title">references</h2>
				<div>
					{{#each references}}
					<blockquote class="quote-block">
						{{#if reference}}
						<p class="quote-text">&ldquo;{{reference}}&rdquo;</p>
						{{/if}} {{#if name}}
						<div class="quote-attr">— {{name}}</div>
						{{/if}}
					</blockquote>
					{{/each}}
				</div>
			</section>
			{{/if}}

			<div class="squiggle" aria-hidden="true"></div>

			<footer class="cv-footer no-print">
				<span
					>{{basics.name}}{{#if basics.location.city}} ·
					{{basics.location.city}}{{/if}}</span
				>
				<span>Set in Fira Sans &amp; Fira Code · Catppuccin</span>
			</footer>
		</div>
	</body>
</html>
