{
  "name": "create-stephansama-example",
  "version": "1.4.5",
  "description": "Download an example from the @stephansama/packages examples",
  "keywords": [
    "create-example"
  ],
  "homepage": "https://packages.stephansama.info/api/create-stephansama-example",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephansama/packages.git",
    "directory": "core/example"
  },
  "license": "MIT",
  "author": {
    "name": "Stephan Randle",
    "email": "stephanrandle.dev@gmail.com",
    "url": "https://stephansama.info"
  },
  "sideEffects": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.cjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "bin": "./cli.mjs",
  "files": [
    "./dist"
  ],
  "scripts": {
    "prebuild": "pnpm run generate",
    "build": "tsdown",
    "predev": "pnpm run generate",
    "dev": "tsdown --watch",
    "generate": "pnpm --filter=scripts run generate-examples",
    "prelint": "pnpm run generate",
    "lint": "eslint ./ --pass-on-no-patterns --no-error-on-unmatched-pattern",
    "lint:fix": "eslint ./ --pass-on-no-patterns --no-error-on-unmatched-pattern --fix",
    "typedoc": "pnpm run generate"
  },
  "dependencies": {
    "@bluwy/giget-core": "catalog:",
    "@clack/prompts": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "undici": "catalog:"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
