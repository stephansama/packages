{
  "name": "@stephansama/inline-image",
  "version": "0.1.0",
  "description": "inline an image as a data uri",
  "keywords": [
    "inline-image"
  ],
  "homepage": "https://packages.stephansama.info/api/@stephansama/inline-image",
  "repository": {
    "type": "git",
