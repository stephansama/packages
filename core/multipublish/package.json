{
  "name": "@stephansama/multipublish",
  "version": "1.0.12",
  "description": "Publish packages to multiple providers easily",
  "keywords": [
    "multipublish",
    "tanstack-intent"
  ],
  "homepage": "https://packages.stephansama.info/api/@stephansama/multipublish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephansama/packages.git",
    "directory": "core/multipublish"
  },
  "license": "MIT",
  "author": {
    "name": "Stephan Randle",
    "email": "stephanrandle.dev@gmail.com",
    "url": "https://stephansama.info"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json",
    "./schema": "./dist/schema.mjs",
    "./schema.json": "./dist/schema.json"
  },
  "types": "./config/schema.d.cts",
  "bin": {
    "multipublish": "./dist/cli.mjs"
  },
  "files": [
    "./dist",
    "./config",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint ./src/ --pass-on-no-patterns --no-error-on-unmatched-pattern",
    "lint:fix": "eslint ./src/ --pass-on-no-patterns --no-error-on-unmatched-pattern --fix"
  },
  "dependencies": {
    "@manypkg/find-root": "catalog:manypkg",
    "@manypkg/get-packages": "catalog:manypkg",
    "cosmiconfig": "catalog:cli",
    "dedent": "catalog:",
    "obug": "catalog:cli",
    "package-manager-detector": "catalog:",
    "tinyglobby": "catalog:",
    "yaml": "catalog:",
    "yargs": "catalog:cli",
    "zod": "catalog:schema"
  },
  "devDependencies": {
    "@tanstack/intent": "catalog:tanstack",
    "@types/yargs": "catalog:",
    "es-toolkit": "catalog:",
    "jsr": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:"
  },
  "peerDependencies": {
    "jsr": ">=0.10"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
