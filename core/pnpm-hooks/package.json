{
  "name": "@stephansama/pnpm-hooks",
  "version": "0.1.1",
  "description": "preconfigured pnpm hooks and types for pnpmfile",
  "keywords": [
    "pnpm-hooks"
  ],
  "homepage": "https://packages.stephansama.info/api/@stephansama/pnpm-hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephansama/packages.git",
    "directory": "core/pnpm-hooks"
  },
  "license": "MIT",
  "author": {
    "name": "Stephan Randle",
    "email": "stephanrandle.dev@gmail.com",
    "url": "https://stephansama.info"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./types": "./dist/types.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint ./ --pass-on-no-patterns --no-error-on-unmatched-pattern",
    "lint:fix": "eslint ./ --fix"
  },
  "dependencies": {
    "@pnpm/hooks.pnpmfile": "catalog:pnpm",
    "@pnpm/lockfile.types": "catalog:pnpm",
    "@pnpm/types": "catalog:pnpm"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
