{
  "name": "@stephansama/rehype-bluesky-embed",
  "version": "0.2.0",
  "description": "A rehype plugin that turns links to Bluesky posts into embedded posts.",
  "keywords": [
    "bluesky",
    "embed",
    "oembed",
    "rehype",
    "rehype-plugin"
  ],
  "homepage": "https://packages.stephansama.info/api/@stephansama/rehype-bluesky-embed",
  "bugs": {
    "url": "https://github.com/stephansama/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephansama/packages.git",
    "directory": "core/rehype-bluesky-embed"
  },
  "license": "MIT",
  "author": {
    "name": "Stephan Randle",
    "email": "stephanrandle.dev@gmail.com",
    "url": "https://stephansama.info"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "hast-util-from-html": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile": "catalog:"
  },
  "devDependencies": {
    "rehype-parse": "catalog:",
    "rehype-stringify": "catalog:",
    "remark": "catalog:remark",
    "remark-rehype": "catalog:remark",
    "tsdown": "catalog:",
    "unified": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "readme": "./README.md"
}
