    "smol-toml": "catalog:",
    "xdg-app-paths": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "zod": "catalog:schema"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
