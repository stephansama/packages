{
  "name": "@stephansama/typed-events",
  "version": "3.0.9",
  "description": "Typed events store using standard schema",
  "keywords": [
    "typed-events",
    "standard-schema",
    "validation",
    "events",
    "strict"
  ],
  "homepage": "https://packages.stephansama.info/api/@stephansama/typed-events",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephansama/packages.git",
    "directory": "core/typed-events"
  },
  "license": "MIT",
  "author": {
    "name": "Stephan Randle",
    "email": "stephanrandle.dev@gmail.com",
    "url": "https://stephansama.info"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./errors": "./dist/errors.mjs",
    "./react": "./dist/react.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint ./ --pass-on-no-patterns --no-error-on-unmatched-pattern",
    "lint:fix": "eslint ./ --pass-on-no-patterns --no-error-on-unmatched-pattern --fix"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:schema"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "zod": "catalog:schema"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
