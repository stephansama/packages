{
  "extends": [
    "../../tsconfig.base.json"
  ],
  "include": [
    "./src/**/*"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "lib": [
