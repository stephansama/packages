---
interface Props {
	source: string;
	title: string;
}

const { source, title } = Astro.props;
---

<a class="font-mono" href={source}>visit full page</a>
<iframe src={source} style="width:100%;height:100%;" title={title}></iframe>

<style is:global>
	@reference '../extend.css';

	.main-frame:has(iframe),
	.main-frame:has(iframe) *:not(script):not(footer):not(a) {
		@apply flex grow flex-col;
	}

	.main-frame:has(iframe) footer {
		@apply h-0;
	}

	.main-frame:has(iframe) .sl-container {
		@apply m-0 max-w-none;
	}
</style>
