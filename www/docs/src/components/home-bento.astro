<style is:global>
	.home-root .bento-item::before {
		content: "";
		position: absolute;
		inset: -1px;
		pointer-events: none;
		background: radial-gradient(
			300px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
			color-mix(in srgb, var(--color-mauve) 22%, transparent),
			transparent 70%
		);
		opacity: var(--spotlight-opacity, 0);
		transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 0;
	}

	.home-root .bento-item::after {
		content: attr(data-status);
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: var(--sl-color-bg);
		border-top: 1px solid var(--color-line);
		padding: 6px 12px;
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--color-muted);
		display: flex;
		justify-content: flex-end;
		opacity: 0.6;
		transition: all 0.3s ease;
		z-index: 2;
	}

	.home-root .bento-item:hover::after {
		opacity: 1;
		color: var(--color-mauve);
		background: color-mix(in srgb, var(--color-mauve) 5%, var(--sl-color-bg));
	}

	.home-root .bento-item > * {
		position: relative;
		z-index: 1;
	}

	.home-root .bento-item:hover .bento-graphic {
		opacity: 0.3;
		transform: scale(1.05) rotate(2deg);
	}
</style>

<script>
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;
	const grid = document.querySelector<HTMLElement>("[data-bento-grid]");

	if (grid && !prefersReducedMotion) {
		const items = grid.querySelectorAll<HTMLElement>(".bento-item");
		for (const item of items) {
			item.addEventListener("mousemove", (event) => {
				const rect = item.getBoundingClientRect();
				item.style.setProperty("--mouse-x", `${event.clientX - rect.left}px`);
				item.style.setProperty("--mouse-y", `${event.clientY - rect.top}px`);
			});

			item.addEventListener("mouseenter", () => {
				item.style.setProperty("--spotlight-opacity", "1");
			});

			item.addEventListener("mouseleave", () => {
				item.style.setProperty("--spotlight-opacity", "0");
			});
		}
	}
</script>
