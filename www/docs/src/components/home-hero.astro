---
const initialLines = [
	{ cmd: "pnpm add @stephansama/ai-commit-msg", type: "prompt" },
	{ text: "Resolving dependencies...", type: "output" },
	{ text: "Verified sha256:7dc4e4...", type: "info" },
	{
		text: "Success: @stephansama/ai-commit-msg installed.",
		type: "success",
	},
];

const animatedLines = [
	{
		cmd: "cat manifesto.md",
		output: "Small packages, sharp tools, zero bloat.",
		type: "info",
	},
	{
		cmd: "pnpm -r test",
		output: "All workspace packages verified.",
		type: "success",
	},
	{
		cmd: 'git commit -m "ship"',
		output: "Pushed to origin/main.",
		type: "info",
	},
];
---

<section
	class="grid grid-cols-1 items-center gap-12 py-[clamp(64px,10vw,120px)] font-sans lg:grid-cols-[1.2fr_1fr] lg:gap-20"
>
	<div class="max-w-[600px]">
		<span
			class="border-line bg-surface inline-flex items-center border px-3 py-1 font-mono text-[11px] tracking-[0.1em] text-[var(--sl-color-red)] uppercase"
		>
			PACKAGES :: MONOREPO
		</span>
		<h1
			class="text-fg mt-[0.5em] mb-6 font-sans text-[clamp(40px,8vw,72px)] leading-[1.1] font-semibold tracking-tight"
		>
			@stephansama packages.
		</h1>
		<p class="text-muted mb-12 max-w-[480px] text-xl leading-[1.5] font-normal">
			A collection of TypeScript-first, open-source packages crafted for the
			terminal-native engineer.
		</p>
		<div class="flex flex-wrap gap-4">
			<a
				class="inline-flex cursor-pointer items-center gap-3 border-0 bg-[var(--sl-color-red)] px-7 py-3.5 font-mono text-sm font-semibold text-[var(--sl-color-bg)] no-underline transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-0.5 hover:text-[var(--sl-color-bg)] hover:shadow-[0_8px_24px_color-mix(in_srgb,var(--sl-color-red)_30%,transparent)]"
				href="/api/"
			>
				<svg
					aria-hidden="true"
					fill="none"
					height="18"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
					width="18"
				>
					<path d="M5 12h14M12 5l7 7-7 7"></path>
				</svg>
				Browse API docs
			</a>
			<a
				class="border-line bg-surface text-fg hover:border-muted hover:bg-line hover:text-fg inline-flex cursor-pointer items-center gap-3 border px-7 py-3.5 font-mono text-sm font-semibold no-underline transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]"
				href="https://github.com/stephansama/packages"
				rel="noopener"
			>
				<svg
					aria-hidden="true"
					fill="currentColor"
					height="18"
					viewBox="0 0 24 24"
					width="18"
				>
					<path
						d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.412-4.041-1.412-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
					></path>
				</svg>
				GitHub
			</a>
		</div>
	</div>

	<div
		aria-hidden="true"
		class="terminal border-line bg-surface relative flex h-[440px] flex-col overflow-hidden border shadow-[0_32px_64px_rgba(0,0,0,0.4)]"
	>
		<div
			class="border-line bg-surface flex items-center gap-3 border-b px-4 py-3"
		>
			<span class="inline-block size-2 rounded-[2px] bg-[#ed8796]"></span>
			<span class="inline-block size-2 rounded-[2px] bg-[#eed49f]"></span>
			<span class="bg-pistachio inline-block size-2 rounded-[2px]"></span>
			<span class="text-muted mr-auto ml-auto font-mono text-[11px] opacity-80">
				nvim — manifesto.md
			</span>
		</div>
		<div
			class="terminal-body text-muted grow overflow-y-auto p-5 font-mono text-[13px] leading-[1.6] [scrollbar-color:var(--sl-color-gray-5)_transparent] [scrollbar-width:thin]"
			data-animated-lines={JSON.stringify(animatedLines)}
			data-terminal-body
		>
			{
				initialLines.map((line) =>
					line.type === "prompt" ? (
						<div class="line">
							<span class="prompt">➜</span>
							<span class="cmd">{line.cmd}</span>
						</div>
					) : (
						<div class={`line ${line.type}`}>{line.text}</div>
					),
				)
			}
			<div class="line" data-terminal-cursor>
				<span class="prompt">➜</span>
				<span class="cmd" data-terminal-typing></span>
			</div>
		</div>
	</div>
</section>

<style is:global>
	.home-root .terminal::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--sl-color-red),
			transparent
		);
		opacity: 0.5;
	}

	/* Line styling — initial server-rendered lines and dynamically injected
	   lines from the typing script share these classes. */
	.home-root .terminal-body .line {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 0.375rem;
		word-break: break-all;
	}
	.home-root .terminal-body .line .prompt {
		color: var(--color-peach);
		opacity: 0.8;
	}
	.home-root .terminal-body .line .cmd {
		color: var(--color-fg);
	}
	.home-root .terminal-body .line.output {
		color: var(--color-muted);
	}
	.home-root .terminal-body .line.success {
		color: var(--color-pistachio);
	}
	.home-root .terminal-body .line.info {
		color: var(--color-sapphire);
	}
</style>

<script>
	type AnimatedLine = { cmd: string; output: string; type: string };

	const body = document.querySelector<HTMLElement>("[data-terminal-body]");
	const cursorLine = body?.querySelector<HTMLElement>("[data-terminal-cursor]");
	const typingSpan = body?.querySelector<HTMLElement>("[data-terminal-typing]");

	if (body && cursorLine && typingSpan) {
		const lines: AnimatedLine[] = JSON.parse(
			body.dataset.animatedLines ?? "[]",
		);
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		const makeLine = (cmd: string): HTMLElement => {
			const wrap = document.createElement("div");
			wrap.className = "line";
			const prompt = document.createElement("span");
			prompt.className = "prompt";
			prompt.textContent = "➜";
			const cmdSpan = document.createElement("span");
			cmdSpan.className = "cmd";
			cmdSpan.textContent = cmd;
			wrap.appendChild(prompt);
			wrap.appendChild(cmdSpan);
			return wrap;
		};

		const makeOutput = (text: string, type: string): HTMLElement => {
			const el = document.createElement("div");
			el.className = `line ${type}`;
			el.textContent = text;
			return el;
		};

		if (prefersReducedMotion) {
			cursorLine.remove();
			for (const l of lines) {
				body.appendChild(makeLine(l.cmd));
				body.appendChild(makeOutput(l.output, l.type));
			}
		} else {
			let lineIndex = 0;
			let charIndex = 0;
			let activeSpan: HTMLElement = typingSpan;

			const tick = () => {
				if (lineIndex >= lines.length) return;
				const line = lines[lineIndex];
				if (charIndex < line.cmd.length) {
					activeSpan.textContent =
						(activeSpan.textContent ?? "") + line.cmd.charAt(charIndex);
					charIndex++;
					setTimeout(tick, 40);
				} else {
					body.appendChild(makeOutput(line.output, line.type));
					lineIndex++;
					charIndex = 0;
					if (lineIndex < lines.length) {
						const next = makeLine("");
						body.appendChild(next);
						activeSpan = next.querySelector(".cmd") as HTMLElement;
						setTimeout(tick, 800);
					}
				}
			};
			setTimeout(tick, 1500);
		}
	}
</script>
