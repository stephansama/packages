---
import Default from "@astrojs/starlight/components/SkipLink.astro";

/* https://hideoo.dev/notes/starlight-custom-html-head#google-tag-manager */
---

<!-- Add the noscript tag for Google Tag Manager. -->
<noscript>
	<iframe
		height="0"
		src={`https://www.googletagmanager.com/ns.html?id=${"GTM-PJ2232VH"}`}
		style="display:none;visibility:hidden"
		title="googletagmanager"
		width="0"
	>
	</iframe>
</noscript>

<!-- Render the default <SkipLink/> component. -->
<Default><slot /></Default>
